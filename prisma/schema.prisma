// Virtual Library - PostgreSQL schema
// Run: npx prisma generate && npx prisma db push (or migrate dev)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  studentId        String?   @unique // VL-YYYY-MM-XXXXX (e.g. VL-2026-03-47291)
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  password         String? // hashed; null for OAuth-only users
  goal             String? // e.g. UPSC, JEE, etc.
  role             String    @default("STUDENT") // ADMIN | EMPLOYEE | STUDENT | INFLUENCER | AUTHOR
  referralCode     String?   @unique // for influencers/referrals (e.g. INV-ABC123)
  referredById     String? // user who referred this account (typically an INFLUENCER)
  referralRewarded Boolean   @default(false) // has first-purchase referral reward been granted
  isSuperAdmin     Boolean   @default(false) // DB-controlled superadmin — replaces hardcoded email check
  trialUsed        Boolean   @default(false) // 7-day free trial already claimed
  deletedAt        DateTime? // soft delete: moved to bin; auto-deleted after 30 days
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts              Account[]
  sessions              Session[]
  studySessions         StudySession[]
  profile               Profile?
  loginLogs             LoginLog[]
  couponRedemptions     CouponRedemption[]
  roomSubscriptions     RoomSubscription[]
  roomCheckIns          RoomCheckIn[]
  transactions          Transaction[]
  rewardWinnings        RewardWinner[]
  whatsAppMessages      WhatsAppMessage[]
  formSubmissions       StudentFormSubmission[]
  digitalPurchases      DigitalPurchase[]
  author                Author? // one-to-one: user linked as blog author
  dailyTasks            DailyTask[]
  meetPollResponses     MeetPollResponse[]
  meetAddonLinkCodes    MeetAddonLinkCode[]
  moduleAccess          StudentModuleAccess[]
  focusSessions         FocusSession[]
  meetPresenceSessions  MeetPresenceSession[]
  pomodoroTimerSessions PomodoroTimerSession[]
  studyCoinLogs         StudyCoinLog[]
  studyStreak           StudyStreak?
  moodLogs              MoodLog[]
  feedbacks             Feedback[]

  referredBy         User?               @relation("UserReferrals", fields: [referredById], references: [id])
  referrals          User[]              @relation("UserReferrals")
  adminCoinLogs      StudyCoinLog[]      @relation("AdminCoinLogs")
  aiUsageLogs        AIUsageLog[]        @relation("AIUsageLogs")
  trialLogs          TrialLog[]
  employeePermission EmployeePermission?
  blogComments       BlogComment[]
  adminAuditLogs     AdminAuditLog[]
  studentEvents      StudentEvent[]
  userSubscriptions  UserSubscription[]
}

// Plan-based membership subscription (monthly / yearly)
model UserSubscription {
  id               String   @id @default(cuid())
  userId           String
  planType         String   // MONTHLY | YEARLY
  startDate        DateTime @default(now())
  endDate          DateTime
  status           String   @default("ACTIVE") // ACTIVE | EXPIRED | CANCELLED
  amountPaid       Int
  transactionId    String?
  paymentGatewayId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, endDate])
}

model LoginLog {
  id       String    @id @default(cuid())
  userId   String
  loginAt  DateTime  @default(now())
  logoutAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, loginAt])
}

model Profile {
  id                  String    @id @default(cuid())
  userId              String    @unique
  fullName            String?
  phone               String?
  whatsappNumber      String?
  studyGoal           String?
  targetExam          String?
  targetYear          String?
  primaryPainPoint    String?
  institution         String?
  bio                 String?
  totalStudyHours     Int       @default(0)
  profilePicUrl       String?
  currentStreak       Int       @default(0)
  lastStudyDate       DateTime?
  longestStreak       Int       @default(0)
  totalPoints         Int       @default(0)
  coinBalance         Int       @default(0) // materialized coin balance — updated atomically on earn/spend
  whatsappMarketing   Boolean   @default(true) // user opted in to WhatsApp marketing messages at signup
  dailyMantra         String?   @db.Text
  position            String?
  customFields        Json? // admin-defined custom fields (key -> value)
  createdAt           DateTime  @default(now())
  liveStatus          String    @default("Offline")
  liveStatusUpdatedAt DateTime?
  updatedAt           DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([whatsappNumber]) // signup duplicate check: OR [{ whatsappNumber }, { phone }]
  @@index([phone])          // signup duplicate check
  @@index([coinBalance])    // leaderboard queries ordering by coinBalance
}

// Admin-defined profile fields per role (Student, Staff, Author)
model ProfileFieldDefinition {
  id        String  @id @default(cuid())
  role      String // STUDENT | EMPLOYEE | AUTHOR
  key       String // unique key (e.g. father_name)
  label     String // display label
  type      String  @default("text") // text | number | email | textarea | select
  required  Boolean @default(false)
  options   Json? // for select: ["Option A", "Option B"]
  sortOrder Int     @default(0)

  @@unique([role, key])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId]) // required for 1-device deleteMany + session findFirst queries
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Bookable study slots (admin-managed)
model StudySlot {
  id              String   @id @default(cuid())
  roomId          String?  @unique // e.g. RM-2026-03-47291 (unique room ID)
  name            String // e.g. "Morning"
  timeLabel       String // e.g. "8:00 AM – 12:00 PM"
  goal            String? // e.g. UPSC, JEE, NEET, or null for any
  slotType        String   @default("STUDY") // STUDY | MENTORSHIP | MENTAL
  meetLink        String? // Google Meet URL
  calendarEventId String? // Associated Google Calendar Event ID for auto-admit
  capacity        Int      @default(10)
  price           Int      @default(0) // price in rupees (0 = free)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subscriptions RoomSubscription[]
  checkIns      RoomCheckIn[]
  studySessions StudySession[]

  @@index([isActive, slotType]) // public slots query: WHERE isActive=true AND slotType=?
  @@index([isActive])           // slots list: WHERE isActive=true ORDER BY createdAt
}

// Student's purchased room subscriptions (after checkout)
model RoomSubscription {
  id          String   @id @default(cuid())
  userId      String
  studySlotId String
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySlot StudySlot @relation(fields: [studySlotId], references: [id], onDelete: Cascade)

  @@unique([userId, studySlotId])
  @@index([userId])
  @@index([studySlotId])
  @@index([createdAt])
}

// Coupons: one-time use per user (one user can apply a coupon only once)
model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique // e.g. SAVE10, WELCOME20
  discountType   String // PERCENT | FIXED
  discountValue  Int // e.g. 10 for 10%, or 50 for ₹50
  minOrderAmount Int? // optional minimum order (in rupees)
  maxTotalUses   Int? // optional; null = unlimited total redemptions
  validFrom      DateTime? // optional start date
  validUntil     DateTime? // optional end date
  isActive       Boolean   @default(true)
  isPublic       Boolean   @default(false) // show publicly on checkout page
  description    String? // e.g. "10% off"
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id       String   @id @default(cuid())
  couponId String
  userId   String
  usedAt   DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, userId]) // one user can use one coupon only once
}

// WhatsApp OTP for Sign Up
model WhatsAppOTP {
  id          String   @id @default(cuid())
  phoneNumber String
  otp         String
  expiresAt   DateTime
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([phoneNumber])
  @@index([phoneNumber, expiresAt]) // fast lookup for OTP validation queries
}

// WhatsApp Message History (Admin to Student, Student to Admin)
model WhatsAppMessage {
  id          String   @id @default(cuid())
  wamid       String?  @unique // Meta WhatsApp Message ID — used to match delivery/read status
  userId      String?
  phoneNumber String
  direction   String   // "INBOUND" | "OUTBOUND"
  content     String   @db.Text // AES-256-GCM encrypted (base64url)
  contentIv   String?  // Encryption IV — null = legacy plain text row
  status      String   @default("SENT") // SENT | DELIVERED | READ | FAILED
  createdAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([phoneNumber])
  @@index([wamid])
}

// Blog posts (admin-managed, SEO fields)
model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?   @db.Text
  body            String    @db.Text
  coverImage      String?   // featured/cover image URL
  metaTitle       String? // SEO title
  metaDescription String?   @db.Text // SEO meta description
  customCss       String?   @db.Text // optional custom CSS for this post (sanitized)
  publishedAt     DateTime? // null = draft
  authorId        String? // optional link to Author
  views           Int       @default(0) // Engagement tracking
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  author   Author?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  comments BlogComment[]

  @@index([publishedAt]) // blog listing: WHERE publishedAt IS NOT NULL ORDER BY publishedAt DESC
}

// Comments added to public blog posts by logged in users
model BlogComment {
  id        String   @id @default(cuid())
  postId    String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([userId])
}

// Blog authors (admin-managed; can be linked to User for author dashboard)
model Author {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique // URL-friendly (e.g. john-doe)
  bio          String?  @db.Text
  imageUrl     String?
  userId       String?  @unique // when set, this user can log in and manage their posts at /author
  customFields Json? // admin-defined custom fields for AUTHOR profile
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  posts BlogPost[]
}

// Razorpay API keys (Key Secret stored encrypted; admin only)
model RazorpaySetting {
  id                 String   @id @default(cuid())
  keyId              String? // Key ID (public, for frontend)
  keySecretEncrypted String?  @db.Text // Key Secret encrypted with ENCRYPTION_KEY
  iv                 String?  @db.Text // IV for decryption
  updatedAt          DateTime @updatedAt
}

// SMTP / email settings (password stored encrypted; admin only)
model SmtpSetting {
  id            String   @id @default(cuid())
  host          String? // SMTP_HOST
  port          Int? // SMTP_PORT
  user          String? // SMTP_USER
  passEncrypted String?  @db.Text // SMTP_PASS encrypted with ENCRYPTION_KEY
  iv            String?  @db.Text // IV for decryption
  from          String? // SMTP_FROM
  updatedAt     DateTime @updatedAt
}

// Student order/transaction (after checkout)
model Transaction {
  id               String   @id @default(cuid())
  transactionId    String   @unique // e.g. TXN-2026-03-47291
  userId           String
  amount           Int // total amount in rupees
  currency         String   @default("INR")
  status           String   @default("SUCCESS") // SUCCESS | PENDING | FAILED
  paymentGatewayId String? // e.g. Razorpay payment_id
  orderDetails     Json? // [{ slotId?, productId?, name, price }]
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([paymentGatewayId]) // payment dedup: findFirst({ where: { paymentGatewayId } })
}

// Digital products for store (PDFs, courses, etc.)
model DigitalProduct {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  price       Int // rupees
  coinPrice   Int?     // coins required to unlock (null = not available for coins)
  imageUrl    String? // optional cover image
  downloadUrl String?  @db.Text // link or path to file (e.g. S3 URL, or /api/download/xxx)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  purchases DigitalPurchase[]
}

// User's purchase of a digital product (grants download access)
model DigitalPurchase {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  transactionId String? // link to payment
  purchasedAt   DateTime @default(now())

  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product DigitalProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId]) // prevent duplicate purchases at DB level
  @@index([userId])
  @@index([productId])
}

// Marketing / lead capture form submissions (public landing form)
model LeadSubmission {
  id        String   @id @default(cuid())
  data      Json // dynamic key -> value pairs from landing form
  source    String? // optional source/utm or notes
  createdAt DateTime @default(now())
}

// Meet add-on: today's tasks (multiple per day; shown in Meet side panel + dashboard)
model DailyTask {
  id          String    @id @default(cuid())
  userId      String
  taskDate    DateTime  @db.Date // which day this task is for
  title       String    @db.Text // main heading
  description String?   @db.Text // optional details
  priority    Int       @default(2) // 0 = Daily Promise, 1 = High, 2 = Medium, 3 = Normal
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subtasks DailyTaskSubtask[]

  @@index([userId, taskDate])
  @@index([userId])
  @@index([taskDate])
}

// Sub-tasks inside a daily task (max 10 per task)
model DailyTaskSubtask {
  id          String    @id @default(cuid())
  taskId      String
  title       String    @db.Text
  completedAt DateTime?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())

  task DailyTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// Meet add-on: poll/quiz (admin-created; shown in Meet side panel)
model MeetPoll {
  id        String    @id @default(cuid())
  question  String    @db.Text
  options   Json // ["Option A", "Option B", ...]
  isActive  Boolean   @default(true)
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  responses MeetPollResponse[]
}

// Meet add-on: shared room context for real-time features
model MeetRoom {
  id        String   @id @default(cuid())
  roomKey   String   @unique // Meet meetingCode or fallback room identifier
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions              FocusSession[]
  coinLogs              StudyCoinLog[]
  presenceSessions      MeetPresenceSession[]
  pomodoroTimerSessions PomodoroTimerSession[]
}

// Meet add-on: time student had add-on open in a meeting (heartbeat + end)
model MeetPresenceSession {
  id              String    @id @default(cuid())
  userId          String
  roomId          String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  lastHeartbeatAt DateTime  @default(now())
  durationSeconds Int?      // calculated on end: endedAt - startedAt
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room MeetRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([roomId])
  @@index([userId, endedAt])   // slot-wise time queries
}

// Meet add-on: student's poll/quiz response (shown on dashboard)
model MeetPollResponse {
  id        String   @id @default(cuid())
  userId    String
  pollId    String
  answer    String // selected option text or answer
  createdAt DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  poll MeetPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([userId, pollId])
  @@index([userId])
  @@index([pollId])
}

// Meet add-on: one-time code to link add-on without typing password (from dashboard)
model MeetAddonLinkCode {
  id        String   @id @default(cuid())
  userId    String
  code      String // 6-digit code
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([code])
  @@index([code])
  @@index([expiresAt])
}

// Meet add-on: pomodoro/focus sessions
model FocusSession {
  id           String    @id @default(cuid())
  roomId       String
  userId       String
  workMinutes  Int       @default(25)
  breakMinutes Int       @default(5)
  cycles       Int       @default(0)
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  room MeetRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([roomId, userId])
}

// Meet add-on: Pomodoro watch timer (start → stop or full complete)
model PomodoroTimerSession {
  id               String   @id @default(cuid())
  userId           String
  roomId           String
  plannedSeconds   Int // countdown length when Start was pressed
  completedSeconds Int // seconds actually run
  completedFully   Boolean  @default(false)
  startedAt        DateTime @default(now())
  endedAt          DateTime @default(now())

  user User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  room MeetRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
  @@index([roomId])
}

// Meet add-on: coin ledger for gamification
model StudyCoinLog {
  id            String   @id @default(cuid())
  txnId         String?  @unique          // TXN + timestamp + random (e.g. TXN17170284938821)
  roomId        String?
  userId        String
  coins         Int
  reason        String
  balanceBefore Int?                      // coinBalance snapshot before this entry
  balanceAfter  Int?                      // coinBalance snapshot after this entry
  adminId       String?                   // admin who triggered this (manual grant/deduct)

  // ── Rich audit metadata ──────────────────────────────────────────────────
  sourceCategory String?  @db.VarChar(50)  // 'coin_pack'|'checkin_bonus'|'study_session'|'admin_grant'|'admin_deduct'|'product_purchase'|'ai_usage'|'daily_streak'|'achievement'|'referral_bonus'|'welcome_bonus'|'refund'|'cashback'|'subscription'|'course_unlock'|'quiz_attempt'
  sourceLabel    String?  @db.VarChar(200) // "Starter Pack (100 coins)", "Daily check-in"
  referenceType  String?  @db.VarChar(50)  // 'payment'|'product'|'course'|'quiz'|'referral'|'admin'|'system'
  referenceId    String?  @db.VarChar(100) // Razorpay PAY123 / product CUID / etc.
  referenceName  String?  @db.VarChar(200) // Human-readable: "Study Pack", "Maths Ch.5"
  deviceType     String?  @default("web_browser") @db.VarChar(50) // 'mobile_app'|'web_browser'|'admin_panel'|'system'
  ipAddress      String?  @db.Inet         // Native PostgreSQL INET type
  adminName      String?  @db.VarChar(100) // Denormalised for fast access without join
  adminReason    String?  @db.Text         // Admin-provided justification

  createdAt     DateTime @default(now())

  room  MeetRoom? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin User?     @relation("AdminCoinLogs", fields: [adminId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([roomId])
  @@index([userId, reason])          // AI message count queries: WHERE reason LIKE 'AI_MSG%'
  @@index([adminId])
  @@index([createdAt])               // full-log queries: ORDER BY createdAt DESC without userId filter
  @@index([userId, sourceCategory])  // per-student category filter
  @@index([sourceCategory, createdAt]) // platform-wide category analytics
}

// Meet add-on: persistent streak counter
model StudyStreak {
  id          String    @id @default(cuid())
  userId      String    @unique
  currentDays Int       @default(0)
  longestDays Int       @default(0)
  lastStudyOn DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Reward program: admin creates rewards; winners get amount
model Reward {
  id               String   @id @default(cuid())
  name             String // e.g. "Top Streak of the Month"
  description      String?  @db.Text
  amount           Int // prize amount in rupees (what winner receives)
  enrollmentAmount Int      @default(0) // rupees student pays to enroll in this reward
  type             String   @default("OTHER") // STREAK, REFERRAL, CONTEST, OTHER
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  winners RewardWinner[]
}

model RewardWinner {
  id       String    @id @default(cuid())
  userId   String
  rewardId String
  status   String    @default("PENDING") // PENDING | PAID
  wonAt    DateTime  @default(now())
  paidAt   DateTime?
  notes    String?   @db.Text

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reward Reward @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@unique([userId, rewardId])
}

// Tracks study hours per user
model StudySession {
  id              String    @id @default(cuid())
  userId          String
  studySlotId     String?   // auto-detected from Google Meet ID
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int?
  createdAt       DateTime  @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySlot StudySlot?  @relation(fields: [studySlotId], references: [id], onDelete: SetNull)

  @@index([userId, startedAt])
  @@index([userId, endedAt])
  @@index([startedAt])
  @@index([studySlotId])
}

// Room check-in: student marks attendance for a subscribed slot (dashboard or WhatsApp)
model RoomCheckIn {
  id          String   @id @default(cuid())
  userId      String
  studySlotId String
  checkedInAt DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  studySlot StudySlot @relation(fields: [studySlotId], references: [id], onDelete: Cascade)

  @@index([userId, studySlotId])
  @@index([checkedInAt])
}

// Admin-created form that students fill from dashboard (e.g. feedback, survey)
model StudentForm {
  id          String   @id @default(cuid())
  title       String // e.g. "Student Feedback Form"
  description String?  @db.Text
  isActive    Boolean  @default(true) // only one active form shown to students
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  fields      StudentFormField[]
  submissions StudentFormSubmission[]
}

model StudentFormField {
  id       String  @id @default(cuid())
  formId   String
  label    String // e.g. "Full Name"
  type     String  @default("TEXT") // TEXT, EMAIL, NUMBER, TEXTAREA, SELECT
  required Boolean @default(false)
  options  String? @db.Text // for SELECT: comma-separated options
  order    Int     @default(0)

  form StudentForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}

model StudentFormSubmission {
  id          String   @id @default(cuid())
  formId      String
  userId      String
  data        Json // { fieldId: value, ... }
  submittedAt DateTime @default(now())

  form StudentForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([formId])
  @@index([userId])
}

// Website traffic / visitor tracking (IP, device, path, geo, referrer)
model TrafficVisit {
  id         String   @id @default(cuid())
  ip         String
  userAgent  String?  @db.Text
  deviceType String
  path       String?
  country     String?
  city        String?
  referrer    String?
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([ip])
  @@index([country, createdAt])
  @@index([path, createdAt])
}

// Admin-configurable app settings (env vars stored in DB; secrets encrypted)
model AppSetting {
  id             String   @id @default(cuid())
  key            String   @unique // e.g. WHATSAPP_PHONE_NUMBER_ID, CRON_SECRET
  valueEncrypted String?  @db.Text // value (plain or encrypted; if iv set then encrypted)
  iv             String?  @db.Text
  updatedAt      DateTime @updatedAt
}

// Dashboard Productivity Tracker
model MoodLog {
  id        String   @id @default(cuid())
  userId    String
  level     Int // 1=Low, 2=Medium, 3=High
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  category  String // BUG, FEATURE_REQUEST, UI_UX, PERFORMANCE, OTHER
  message   String   @db.Text
  rating    Int?
  status    String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Admin-managed Dynamic FAQs
model Faq {
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.Text
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Gamification Coin Engine Rules
model ActionReward {
  id        String   @id @default(cuid())
  actionKey String   @unique // e.g. POMODORO_CYCLE_COMPLETED
  label     String // Dashboard friendly name
  coins     Int // Number of coins to award
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Email HTML Templates
model EmailTemplate {
  id        String   @id @default(cuid())
  purpose   String   @unique // OTP_VERIFY | OTP_RESET | MAGIC_LINK_VERIFY | CUSTOM
  subject   String
  bodyHtml  String   @db.Text
  variables Json?    // ["code","name","verify_url"] — hints for editor
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Log of every sent email — Resend webhook updates delivery/open/click
model EmailLog {
  id           String    @id @default(cuid())
  resendId     String?   @unique // Resend email ID — used for webhook matching
  toEmail      String
  toName       String?
  subject      String
  purpose      String    @default("GENERAL")
  status       String    @default("SENT") // SENT | DELIVERED | OPENED | BOUNCED | FAILED
  errorMessage String?   @db.Text
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  bouncedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([toEmail])
  @@index([createdAt])
  @@index([status])
}

// Email signatures — admin can attach to manual/bulk emails
model EmailSignature {
  id        String   @id @default(cuid())
  name      String
  html      String   @db.Text
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Custom Drafts Library for HTML Emails
model EmailDraft {
  id        String   @id @default(cuid())
  name      String
  subject   String
  bodyHtml  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Custom Employee Access Engine
model EmployeePermission {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  modules   String[] // Array of allowed module keys
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Per-student module access overrides (admin can disable specific modules per student)
model StudentModuleAccess {
  userId   String
  moduleId String
  disabled Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, moduleId])
  @@index([userId])
}

// Security audit trail — login, logout, password change, failed attempts, suspicious activity
model SecurityAuditLog {
  id        String   @id @default(cuid())
  eventType String   @db.VarChar(50)
  // 'login' | 'logout' | 'password_change' | 'failed_login' | 'signup'
  // | 'coin_transaction' | 'admin_access' | 'suspicious_activity' | 'session_revoked'
  userId    String?
  ipAddress String?  @db.Inet
  userAgent String?  @db.Text
  details   Json?    // event-specific metadata (never include passwords or secrets)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([eventType, createdAt])
  @@index([ipAddress])
  @@index([createdAt])
}

// Admin "View as Student" access audit trail
model AdminStudentAccessLog {
  id              String    @id @default(cuid())
  adminId         String
  adminName       String    @db.VarChar(100)
  adminIp         String?   @db.Inet
  studentId       String
  studentUniqueId String?   @db.VarChar(20)
  studentName     String?   @db.VarChar(100)
  pageAccessed    String    @db.VarChar(200) // e.g. '/dashboard/wallet'
  action          String    @default("view") @db.VarChar(50) // 'search'|'view'|'impersonate'|'exit'
  sessionToken    String?   @db.VarChar(200) // impersonation token (first 16 chars stored)
  accessedAt      DateTime  @default(now())
  endedAt         DateTime?

  @@index([adminId])
  @@index([studentId])
  @@index([accessedAt])
  @@index([adminId, accessedAt])
}

// System Audit Logging to track backend actions
model AdminAuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  module    String
  details   String   @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([module, createdAt]) // admin panel filters by module + date
}

// Student activity tracking — every page view, feature use, error, and action
model StudentEvent {
  id        String   @id @default(cuid())
  userId    String
  event     String   // PAGE_VIEW | BUTTON_CLICK | FEATURE_USED | FORM_SUBMIT | ERROR | PAYMENT_INITIATED | PAYMENT_SUCCESS | PAYMENT_FAILED | CUSTOM
  page      String?  // pathname at time of event
  meta      Json?    // extra data: { label, value, error, featureName, ... }
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@index([userId, event])
}

// Per-event trial audit log — enrolled, expired, converted, retrial_blocked, dashboard_locked, admin_reset
model TrialLog {
  id         String   @id @default(cuid())
  userId     String
  event      String   // enrolled | expired | converted | retrial_blocked | dashboard_locked | admin_reset
  detail     String?  @db.Text
  ipAddress  String?
  userAgent  String?  @db.Text
  planBought String?  // plan name for "converted" event
  daysUsed   Int?     // days elapsed for "expired"/"converted" events
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@index([createdAt])
}

// WhatsApp template library — synced from Meta + trigger config set by admin
model WhatsAppTemplate {
  id             String    @id @default(cuid())
  metaId         String?   @unique          // Meta template ID
  name           String    @unique
  status         String    @default("PENDING") // APPROVED | PENDING | REJECTED | PAUSED
  category       String?
  language       String    @default("en")
  bodyText       String    @db.Text
  headerText     String?   @db.Text
  footerText     String?
  variableCount  Int       @default(0)
  variableLabels Json?     // ["Student Name", "Student ID", "Login URL"]
  buttons        Json?
  triggerEvent   String?   // "signup" | "daily_8pm" | "3days_before" | "1day_before" | "manual"
  isActive       Boolean   @default(false)
  syncedAt       DateTime? // last synced from Meta
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([triggerEvent])
  @@index([status])
}

// Per-call AI API usage log — powers the admin AI Usage dashboard
model AIUsageLog {
  id           String   @id @default(cuid())
  logId        String   @unique          // e.g. AILOG17170001234567
  userId       String?                   // null = system call (routing, profiling)
  feature      String                    // "studymate" | "studymate_meet" | "profile_extract" | "router"
  provider     String                    // "google" | "anthropic" | "openai"
  model        String                    // "gemini-2.5-flash" | "claude-sonnet" | "gpt-4o" etc.
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  totalTokens  Int      @default(0)      // = inputTokens + outputTokens
  costUsd      Float    @default(0)      // approximate actual API cost in USD
  costInr      Float    @default(0)      // costUsd × exchange rate
  coinsCharged Int      @default(0)      // coins deducted from student wallet
  latencyMs    Int      @default(0)      // end-to-end API response time ms
  status       String   @default("success") // "success" | "error" | "timeout"
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())

  user User? @relation("AIUsageLogs", fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([provider, createdAt])
  @@index([feature, createdAt])
  @@index([createdAt])
  @@index([status])
}
